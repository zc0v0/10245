<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.crossborder.controller.ProductsController"
      spacing="15">
    
    <Label text="商品管理" styleClass="section-title">
        <font>
            <Font size="20"/>
        </font>
    </Label>
    
    <HBox styleClass="toolbar" spacing="15">
        <Label text="搜索:"/>
        <TextField fx:id="searchField" promptText="商品名称 / SKU" 
                   styleClass="search-field" prefWidth="250"/>
        
        <Label text="分类:"/>
        <ComboBox fx:id="categoryCombo" styleClass="combo-box" prefWidth="150">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="全部"/>
                </FXCollections>
            </items>
        </ComboBox>
        
        <Label text="库存状态:"/>
        <ComboBox fx:id="stockCombo" styleClass="combo-box" prefWidth="120">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="全部"/>
                    <String fx:value="正常"/>
                    <String fx:value="库存不足"/>
                </FXCollections>
            </items>
        </ComboBox>
        
        <Button fx:id="searchBtn" text="搜索" onAction="#handleSearch" 
                styleClass="primary-button"/>
        
        <Button fx:id="refreshBtn" text="刷新" onAction="#handleRefresh" 
                styleClass="primary-button"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <Button fx:id="classifyBtn" text="智能分类" onAction="#handleClassify" 
                styleClass="primary-button">
            <graphic>
                <Label text="🏷️"/>
            </graphic>
        </Button>
    </HBox>
    
    <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameCol" text="商品名称" prefWidth="200"/>
            <TableColumn fx:id="skuCol" text="SKU" prefWidth="120"/>
            <TableColumn fx:id="categoryCol" text="分类" prefWidth="120"/>
            <TableColumn fx:id="priceCol" text="售价" prefWidth="100"/>
            <TableColumn fx:id="costPriceCol" text="成本价" prefWidth="100"/>
            <TableColumn fx:id="stockCol" text="库存" prefWidth="80"/>
            <TableColumn fx:id="safetyStockCol" text="安全库存" prefWidth="80"/>
            <TableColumn fx:id="salesCol" text="销量" prefWidth="80"/>
            <TableColumn fx:id="statusCol" text="状态" prefWidth="100"/>
        </columns>
    </TableView>
    
    <HBox styleClass="stats-box" spacing="30" alignment="CENTER_LEFT">
        <VBox>
            <Label text="商品总数" styleClass="stats-label"/>
            <Label fx:id="totalProductsLabel" text="0" styleClass="stats-value"/>
        </VBox>
        <VBox>
            <Label text="库存不足" styleClass="stats-label"/>
            <Label fx:id="lowStockLabel" text="0" styleClass="stats-value" style="-fx-text-fill: #e74c3c;"/>
        </VBox>
        <VBox>
            <Label text="热销商品(TOP10)" styleClass="stats-label"/>
            <Label fx:id="hotProductsLabel" text="0" styleClass="stats-value" style="-fx-text-fill: #e67e22;"/>
        </VBox>
    </HBox>
    
</VBox>
