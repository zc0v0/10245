<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.crossborder.controller.StoresController"
      spacing="15">
    
    <Label text="店铺管理" styleClass="section-title">
        <font>
            <Font size="20"/>
        </font>
    </Label>
    
    <HBox styleClass="toolbar" spacing="15">
        <Label text="搜索:"/>
        <TextField fx:id="searchField" promptText="店铺名称 / 平台" 
                   styleClass="search-field" prefWidth="250"/>
        
        <Label text="状态:"/>
        <ComboBox fx:id="statusCombo" styleClass="combo-box" prefWidth="120">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="全部"/>
                    <String fx:value="启用"/>
                    <String fx:value="禁用"/>
                </FXCollections>
            </items>
        </ComboBox>
        
        <Button fx:id="searchBtn" text="搜索" onAction="#handleSearch" 
                styleClass="primary-button"/>
        
        <Button fx:id="refreshBtn" text="刷新" onAction="#handleRefresh" 
                styleClass="primary-button"/>
        
        <Region HBox.hgrow="ALWAYS"/>
        
        <Button fx:id="addBtn" text="添加店铺" onAction="#handleAddStore" 
                styleClass="primary-button">
            <graphic>
                <Label text="➕"/>
            </graphic>
        </Button>
    </HBox>
    
    <TableView fx:id="storesTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameCol" text="店铺名称" prefWidth="250"/>
            <TableColumn fx:id="platformCol" text="平台" prefWidth="120"/>
            <TableColumn fx:id="storeUrlCol" text="店铺URL" prefWidth="200"/>
            <TableColumn fx:id="activeCol" text="状态" prefWidth="100"/>
            <TableColumn fx:id="createdAtCol" text="创建时间" prefWidth="180"/>
            <TableColumn fx:id="actionCol" text="操作" prefWidth="200"/>
        </columns>
    </TableView>
    
    <HBox styleClass="stats-box" spacing="30" alignment="CENTER_LEFT">
        <VBox>
            <Label text="店铺总数" styleClass="stats-label"/>
            <Label fx:id="totalStoresLabel" text="0" styleClass="stats-value"/>
        </VBox>
        <VBox>
            <Label text="已启用" styleClass="stats-label"/>
            <Label fx:id="activeStoresLabel" text="0" styleClass="stats-value" style="-fx-text-fill: #27ae60;"/>
        </VBox>
        <VBox>
            <Label text="已禁用" styleClass="stats-label"/>
            <Label fx:id="inactiveStoresLabel" text="0" styleClass="stats-value" style="-fx-text-fill: #95a5a6;"/>
        </VBox>
    </HBox>
    
</VBox>
